---
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { getCollection } from "astro:content";
import { formatDate } from "@/utils/posts.utils";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, publishedAt, updatedAt } = post.data;
---

<ArticleLayout pageTitle={title}>
  <article class="prose prose-invert max-w-none">
    <div class="-mt-4 mb-6 text-gray-400 text-sm">
      <time datetime={publishedAt.toISOString()}>
        Publicado em {formatDate(publishedAt)}
      </time>
      {
        updatedAt && (
          <time datetime={updatedAt.toISOString()} class="block mt-1">
            Atualizado em {formatDate(updatedAt)}
          </time>
        )
      }
    </div>
    <Content />
  </article>
</ArticleLayout>
