---
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import { getCollection } from "astro:content";
import {
  organizePostsByHeading,
  sortPostsByPublishedAt,
} from "@/utils/posts.utils";

const posts = (await getCollection("blog")).sort(sortPostsByPublishedAt);
const postsByHeading = organizePostsByHeading(
  posts,
  ["day", "monthLong", "year"],
  " "
);
---

<ArticleLayout>
  <div class="">
    {
      Object.keys(postsByHeading).map((k) => (
        // <h2 class="">{k}</h2>
        <div class="flex flex-col gap-5">
          {postsByHeading[k].map((p) => (
            <article class="border-b border-b-gray-800 pb-5">
              <h2 class="text-2xl font-semibold pb-3">
                <a href={p.id}> {p.data.title}</a>
              </h2>
              <p>{p.data.description}</p>
              <time class="text-sm text-gray-400">{k.toUpperCase()}</time>
            </article>
          ))}
        </div>
      ))
    }
  </div>
</ArticleLayout>
