---
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import { getCollection } from "astro:content";
import {
  formatDate,
  sortPostsByPublishedAt,
  filterDraftPosts,
} from "@/utils/posts.utils";

const PAGE_TITLE = "Posts em Destaque";

const posts = (await getCollection("blog", filterDraftPosts)).sort(
  sortPostsByPublishedAt
);
---

<ArticleLayout pageTitle={PAGE_TITLE}>
  <div class="flex flex-col gap-5">
    {
      posts.map((post) => (
        <article class="border-b border-b-gray-800 pb-3 last:border-b-0">
          <h2 class="text-2xl font-serif">
            <a href={post.id} class="hover:text-gray-300 transition-colors">
              {post.data.title}
            </a>
          </h2>
          {post.data.description && (
            <p class="pt-1 text-gray-300">{post.data.description}</p>
          )}
          <time
            class="text-sm pt-2 text-gray-400"
            datetime={post.data.publishedAt.toISOString()}
          >
            {formatDate(post.data.publishedAt)
              .toUpperCase()
              .split(" DE ")
              .join(" ".toUpperCase())}
          </time>
        </article>
      ))
    }
  </div>
</ArticleLayout>
