---
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import { getCollection } from "astro:content";
import {
  organizePostsByHeading,
  sortPostsByPublishedAt,
} from "@/utils/posts.utils";

const posts = (await getCollection("blog")).sort(sortPostsByPublishedAt);
const postsByHeading = organizePostsByHeading(
  posts,  ["monthLong", "year"],
  ", "
);
---

<ArticleLayout page="Sumário">
  <div class="">
    {Object.keys(postsByHeading).map((k) => 
    <h2 class="">{k}</h2>
    <div class="flex flex-col">
      {postsByHeading[k].map((p) => <a href={p.id}>- {p.data.title}</a>)}
    </div>
    )}
  </div>
</ArticleLayout>
