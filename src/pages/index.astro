---
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import { getAllPosts } from "@/service/posts.service";

const posts = await getAllPosts();
---

<ArticleLayout page="Sumário">
  <div class="font-serif tracking-wider text-2xl">
    <h2 class="opacity-75">2025</h2>
    <div class="flex flex-col">
      {posts.map((post) => <a href={post.id}>- {post.data.title}</a>)}
    </div>
  </div>
</ArticleLayout>
