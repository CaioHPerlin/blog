---
interface Social {
  name: string;
  url: string;
}

const BLOG_TITLE = "C. H. Perlin's Unnecessary Blog";
const BLOG_ACRONYM = "The P.U.B";

const SOCIALS: Social[] = [
  { name: "YouTube", url: "https://www.youtube.com/@caiohperlin" },
  { name: "LinkedIn", url: "https://www.linkedin.com/in/caiohperlin" },
  { name: "GitHub", url: "https://github.com/caiohperlin" },
];
---

<header class="font-serif py-20">
  <a href="/" class="w-fit flex flex-col items-center mx-auto">
    <p class="text-[1.125rem] sm:text-[1.35rem] text-gray-200">
      {BLOG_TITLE}
    </p>
    <h1 class="text-6xl sm:text-7xl w-fit">{BLOG_ACRONYM}</h1>
  </a>
  <nav aria-label="Social media links">
    <ul class="flex w-full justify-center mt-3">
      {
        SOCIALS.map((social) => (
          <li class="border-l border-l-gray-300 first:border-0 px-2">
            <a
              class="underline underline-offset-3 sm:text-lg text-gray-300 hover:text-white transition-colors"
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {social.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
