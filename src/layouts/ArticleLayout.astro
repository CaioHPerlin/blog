---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  page: string;
}

const { page } = Astro.props;
---

<BaseLayout>
  <Header page={page} />
  <div class="">
    <h3 class="">
      {page}
    </h3>
    <slot />
  </div>
  <Footer />
</BaseLayout>
