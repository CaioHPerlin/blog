---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  pageTitle?: string;
}

const { pageTitle } = Astro.props;
---

<BaseLayout pageTitle={pageTitle}>
  <Header />
  <main class="px-5 min-h-screen tracking-wide flex flex-col justify-between">
    <div class="container mx-auto">
      {
        pageTitle && (
          <h1 class="bg-gray-950/30 border border-gray-500 p-4 border-x-0 text-center text-3xl font-serif font-bold mb-6">
            {pageTitle}
          </h1>
        )
      }
      <slot />
    </div>
    <Footer />
  </main>
</BaseLayout>
